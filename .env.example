# Copy to .env for local dev, and set these in Vercel → Project → Settings → Environment Variables.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIjKlmNoPqrStuVwxyz

# Your Telegram chat id (where alerts are sent)
TELEGRAM_CHAT_ID=123456789

# Shared secret that protects /api/cron from strangers. Make it long & random.
CRON_SECRET=change-me-to-a-long-random-string

# Optional: timezone for timestamps in Telegram alerts (IANA name, e.g.
# Asia/Tbilisi, Europe/London). Defaults to UTC if unset.
DISPLAY_TZ=UTC

# Optional heartbeat: when on (1/true/yes/on), every cron run sends a summary
# message listing all services' status, even when everything is UP. Leave unset
# or off for the default (alert only when something is DOWN).
ALWAYS_NOTIFY=off
